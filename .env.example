# Admin key, used for API calls and logging in to the panel
CHATGPT2API_AUTH_KEY=chatgpt2api

# Service listening port, defaults to 3000 (not needed for Docker deployments)
PORT=3000

# Database connection, leave empty to use data/chatgpt2api.db
# PostgreSQL: postgresql://user:password@host:5432/chatgpt2api
# MySQL: mysql://user:password@host:3306/chatgpt2api
DATABASE_URL=
